---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventView from '../components/EventView.astro';
import { pickFeatured } from '../lib/events';

const events = await getCollection('events');
const featured = pickFeatured(events);
if (!featured) {
  throw new Error('Add at least one party in src/content/events.');
}
---

<Base title={featured.data.title} description={featured.data.summary} image={featured.data.ogImage} path="/">
  <div class="page">
    <EventView event={featured} featured />
  </div>
</Base>
