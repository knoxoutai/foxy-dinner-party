---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found · Foxy's Dinner Party"
  description="That page has left the table. The next dinner is waiting on the home page."
  image="/images/thanksgiving/og.jpg"
>
  <div class="page">
    <div class="sheet">
      <header class="sheet-head">
        <p class="eyebrow">404</p>
        <h1 class="display">This seat is empty</h1>
        <p class="display-sub">The page has left the table. The dinner has not.</p>
        <div class="actions center">
          <a class="btn" href="/">Back to the invitation</a>
          <a class="btn btn-ghost" href="/faq">See the FAQ</a>
        </div>
      </header>
    </div>
  </div>
</Base>
